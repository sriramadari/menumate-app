{
  "expo": {
    "name": "menumate",
    "slug": "menumate",
    "scheme": "menumate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sriramadari.menumate"
    },
    "android": {
      "package": "com.sriramadari.menumate",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "./plugins/withReleaseSigning",
      [
        "expo-camera",
        {
          "cameraPermission": "MenuMate uses the camera to scan the QR code on your table."
        }
      ]
    ]
  }
}
