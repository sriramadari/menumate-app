# Auth backend.
#   local    - no database, no network. Phone + OTP verified on-device and
#              the code is shown on screen. This is the default.
#   supabase - real SMS OTP; needs a live project and the two vars below.
EXPO_PUBLIC_AUTH_MODE=local

# Only read when EXPO_PUBLIC_AUTH_MODE=supabase.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
